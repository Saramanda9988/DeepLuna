    "/embedding/upload": {
      "post": {
        "tags": [
          "EmbeddingController"
        ],
        "summary": "上传单个文档并进行向量化",
        "description": "支持PDF、TXT、DOC、DOCX、MD、HTML、XML、JSON等格式",
        "operationId": "uploadDocument",
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "description": "用户ID",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "category",
            "in": "query",
            "description": "文档分类/标签",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "research,技术文档"
          },
          {
            "name": "description",
            "in": "query",
            "description": "文档描述",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "enableChunking",
            "in": "query",
            "description": "是否启用分块",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true
            },
            "example": true
          },
          {
            "name": "chunkSize",
            "in": "query",
            "description": "分块大小",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 800
            },
            "example": 800
          },
          {
            "name": "chunkOverlap",
            "in": "query",
            "description": "分块重叠大小",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 200
            },
            "example": 200
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "file"
                ],
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "description": "上传的文件",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResultDocumentUploadResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResult"
                }
              }
            }
          },
          "405": {
            "description": "Method Not Allowed",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResultVoid"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResult"
                }
              }
            }
          }
        }
      }
    },
    "/embedding/upload/batch": {
      "post": {
        "tags": [
          "EmbeddingController"
        ],
        "summary": "批量上传文档并进行向量化",
        "description": "支持一次上传多个文档文件",
