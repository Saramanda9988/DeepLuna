            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "enableChunking",
            "in": "query",
            "description": "是否启用分块",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true
            },
            "example": true
          },
          {
            "name": "chunkSize",
            "in": "query",
            "description": "分块大小",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 800
            },
            "example": 800
          },
          {
            "name": "chunkOverlap",
            "in": "query",
            "description": "分块重叠大小",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 200
            },
            "example": 200
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "files"
                ],
                "type": "object",
                "properties": {
                  "files": {
                    "type": "array",
                    "description": "上传的文件列表",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResultListDocumentUploadResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResult"
                }
              }
            }
          },
          "405": {
            "description": "Method Not Allowed",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResultVoid"
                }
              }
            }
          },
          "500": {
